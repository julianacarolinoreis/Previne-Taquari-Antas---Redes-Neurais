from hec.heclib.dss import HecDss
from hec.heclib.util import HecTime
from hec.io import TimeSeriesContainer
from hms.model.JythonHms import Exit
import csv
import glob
import os

source_dir = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/hec_hms_audit/multi_event/derived"
local_csv = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/chuvas_horarias.csv"
target = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/hec_hms_calibration/mucum_spatial_rain_thiessen.dss"
MISSING = -3.402823466e+38
months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
weights = {"86472000": 0.4550796672, "02851072": 0.5449203328}

def put_series(dss, pathname, rows):
    date, hour = rows[0]["timestamp_label"].split(" ")
    year, month, day = [int(value) for value in date.split("-")]
    start = HecTime("%02d%s%04d" % (day, months[month - 1], year), "%04d" % (int(hour[:2]) * 100))
    values, times = [], []
    for row in rows:
        raw = row.get("spatial_rain", "").strip()
        values.append(float(raw) if raw else MISSING)
        times.append(start.value())
        start.add(60)
    container = TimeSeriesContainer()
    container.fullName = pathname
    container.interval = 60
    container.times = times
    container.values = values
    container.numberValues = len(values)
    container.units = "MM"
    container.type = "PER-CUM"
    dss.put(container)

local = {}
with open(local_csv, "rb") as handle:
    for row in csv.DictReader(handle):
        local[row["COD_SEQUENCIAL"]] = row

dss = HecDss.open(target)
for source in sorted(glob.glob(source_dir + "/event_*_hourly.csv")):
    event_id = os.path.basename(source).split("_")[1]
    if event_id not in ("19", "22", "24", "26", "27", "28"):
        continue
    with open(source, "rb") as handle:
        source_rows = list(csv.DictReader(handle))
    if not source_rows:
        continue
    spatial_rows = []
    for row in source_rows:
        date, hour = row["timestamp_label"].split(" ")
        cod = date.replace("-", "") + hour[:2] + "00"
        local_row = local.get(cod, {})
        a, b = local_row.get("chuva_86472000", "").strip(), local_row.get("chuva_02851072", "").strip()
        value = weights["86472000"] * float(a) + weights["02851072"] * float(b) if a and b else ""
        spatial_rows.append({"timestamp_label": row["timestamp_label"], "spatial_rain": str(value) if value != "" else ""})
    date = spatial_rows[0]["timestamp_label"].split(" ")[0]
    year, month, day = [int(value) for value in date.split("-")]
    dpart = "01%s%04d" % (months[month - 1], year)
    put_series(dss, "/MUCUM/RAIN_E%s_THIESSEN_86510000/PRECIP-INC/%s/1Hour/OBS/" % (event_id, dpart), spatial_rows)
dss.close()
print("WROTE_MUCUM_SPATIAL_THIESSEN_DSS|%s|weights=86472000:%.10f,02851072:%.10f" % (target, weights["86472000"], weights["02851072"]))
Exit(1)
