from hec.heclib.dss import HecDss
from hec.heclib.util import HecTime
from hec.io import TimeSeriesContainer
from hms.model.JythonHms import Exit
import csv
import glob
import os

source_dir = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/hec_hms_audit/multi_event/derived"
target = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/hec_hms_calibration/mucum_target_multi_event.dss"
local_csv = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/chuvas_horarias.csv"
local_target = r"D:/PREVINE/worktrees/previne-catalogo-pesquisas-20260828/assets/data/hec_hms_calibration/mucum_local_rain_all_events.dss"
MISSING = -3.402823466e+38
months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

def put_series(dss, pathname, rows, field, units, data_type):
    first = rows[0]["timestamp_label"]
    date, hour = first.split(" ")
    year, month, day = [int(value) for value in date.split("-")]
    start = HecTime("%02d%s%04d" % (day, months[month - 1], year), "%04d" % (int(hour.split(":")[0]) * 100))
    values, times = [], []
    for row in rows:
        raw = row.get(field, "")
        values.append(float(raw) if raw.strip() else MISSING)
        times.append(start.value())
        start.add(60)
    container = TimeSeriesContainer()
    container.fullName = pathname
    container.interval = 60
    container.times = times
    container.values = values
    container.numberValues = len(values)
    container.units = units
    container.type = data_type
    dss.put(container)

dss = HecDss.open(target)
for source in sorted(glob.glob(source_dir + "/event_*_hourly.csv")):
    event_id = os.path.basename(source).split("_")[1]
    if event_id not in ("19", "22", "24", "26", "27", "28"):
        continue
    rows = []
    with open(source, "rb") as handle:
        rows = list(csv.DictReader(handle))
    if not rows:
        continue
    first_date = rows[0]["timestamp_label"].split(" ")[0]
    year, month, day = [int(value) for value in first_date.split("-")]
    d_part = "01%s%04d" % (months[month - 1], year)
    put_series(dss, "/MUCUM/RAIN_E%s/PRECIP-INC/%s/1Hour/OBS/" % (event_id, d_part), rows, "86472000_rain_mm_sum", "MM", "PER-CUM")
    put_series(dss, "/MUCUM/RAIN_E%s_86510000/PRECIP-INC/%s/1Hour/OBS/" % (event_id, d_part), rows, "86510000_rain_mm_sum", "MM", "PER-CUM")
    composite_rows = []
    for row in rows:
        target_rain = row.get("86510000_rain_mm_sum", "")
        auxiliary_rain = row.get("86472000_rain_mm_sum", "")
        composite_rows.append({
            "timestamp_label": row["timestamp_label"],
            "composite_rain": target_rain if target_rain.strip() else auxiliary_rain,
        })
    put_series(dss, "/MUCUM/RAIN_E%s_COMPOSITE/PRECIP-INC/%s/1Hour/OBS/" % (event_id, d_part), composite_rows, "composite_rain", "MM", "PER-CUM")
    put_series(dss, "/MUCUM/OBS_E%s/FLOW/%s/1Hour/OBS/" % (event_id, d_part), rows, "86510000_flow_mean", "M3/S", "PER-AVER")
dss.close()
print("WROTE_MUCUM_TARGET_DSS|%s" % target)

local_values = {}
local_02851072_values = {}
with open(local_csv, "rb") as local_handle:
    for local_row in csv.DictReader(local_handle):
        local_values[local_row["COD_SEQUENCIAL"]] = local_row.get("chuva_86472600", "")
        local_02851072_values[local_row["COD_SEQUENCIAL"]] = local_row.get("chuva_02851072", "")

local_dss = HecDss.open(local_target)
for source in sorted(glob.glob(source_dir + "/event_*_hourly.csv")):
    event_id = os.path.basename(source).split("_")[1]
    if event_id not in ("19", "22", "24", "26", "27", "28"):
        continue
    with open(source, "rb") as handle:
        source_rows = list(csv.DictReader(handle))
    if not source_rows:
        continue
    local_rows = []
    for row in source_rows:
        date, hour = row["timestamp_label"].split(" ")
        cod = date.replace("-", "") + hour[:2] + "00"
        local_rows.append({"timestamp_label": row["timestamp_label"], "local_rain": local_values.get(cod, "")})
    first_date = local_rows[0]["timestamp_label"].split(" ")[0]
    year, month, day = [int(value) for value in first_date.split("-")]
    d_part = "01%s%04d" % (months[month - 1], year)
    put_series(local_dss, "/MUCUM/RAIN_E%s_86472600/PRECIP-INC/%s/1Hour/OBS/" % (event_id, d_part), local_rows, "local_rain", "MM", "PER-CUM")
    local_rows_02851072 = []
    for row in source_rows:
        date, hour = row["timestamp_label"].split(" ")
        cod = date.replace("-", "") + hour[:2] + "00"
        local_rows_02851072.append({"timestamp_label": row["timestamp_label"], "local_rain": local_02851072_values.get(cod, "")})
    put_series(local_dss, "/MUCUM/RAIN_E%s_02851072/PRECIP-INC/%s/1Hour/OBS/" % (event_id, d_part), local_rows_02851072, "local_rain", "MM", "PER-CUM")
local_dss.close()
print("WROTE_MUCUM_LOCAL_RAIN_DSS|%s" % local_target)
Exit(1)
